# ============================================================
# Environment / secrets / credentials
# ============================================================

.env
.env.*
*.env
*.env.*

# Even example/template environment files are ignored
# to avoid triggering secret scanners.
*.env.example

# Credential/config files
credentials.*
*credentials*
*secret*
*secrets*
*private-key*
*private_key*
*connection-string*
*connection_string*
*connectionstring*

